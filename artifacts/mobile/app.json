{
  "expo": {
    "name": "ORUN",
    "slug": "mobile",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orun",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.orunsociety.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ORUN, profil fotoğrafı çekebilmen için kameranı kullanır.",
        "NSPhotoLibraryUsageDescription": "ORUN, profil fotoğrafını seçebilmen için fotoğraf kütüphanene erişir.",
        "NSPhotoLibraryAddUsageDescription": "ORUN, kaydettiğin içerikleri fotoğraf kütüphanene eklemek için izin ister.",
        "NSMicrophoneUsageDescription": "ORUN, sesli mesaj göndermen için mikrofonu kullanır.",
        "NSUserTrackingUsageDescription": "Bu izin yalnızca seni daha iyi tanımamız için anonim kullanım istatistikleri toplamamıza yarar.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.orunsociety.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "ORUN",
      "shortName": "ORUN",
      "description": "ORUN — düşünceli insanlar için seçilmiş dijital kulüpler. Ortak ilgi alanları etrafında kurulmuş özel odalara katılın, yapay zekâ destekli sohbetlerin içinde yerinizi alın.",
      "themeColor": "#1B3A6B",
      "backgroundColor": "#0A0A0A",
      "lang": "tr"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "react-native-purchases"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "orun-app"
      }
    }
  }
}
